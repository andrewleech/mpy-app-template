[project]
name = "[[project_name.lower().replace(' ', '-')]]"
version = "0.1.0"
description = "[[project_name]] MicroPython firmware"
requires-python = ">=3.10"

[dependency-groups]
# Host-side development tooling.
dev = [
    [% if version_scheme == "git-versioner" %]"git-versioner",[% endif %]
    "micropython-[[ target_port ]]-stubs",
]

# Used by tools/initial_setup.py to resolve the build containers.
setup = [
    "mpbuild",
    "pyyaml",
]

[tool.ruff]
# Enable pycodestyle (`E`) and Pyflakes (`F`) codes by default.
select = ["E", "F"]
ignore = []

# Allow autofix for all enabled rules (when `--fix`) is provided.
fixable = ["A", "B", "C", "D", "E", "F", "G", "I", "N", "Q", "S", "T", "W", "ANN", "ARG", "BLE", "COM", "DJ", "DTZ", "EM", "ERA", "EXE", "FBT", "ICN", "INP", "ISC", "NPY", "PD", "PGH", "PIE", "PL", "PT", "PTH", "PYI", "RET", "RSE", "RUF", "SIM", "SLF", "TCH", "TID", "TRY", "UP", "YTT"]
unfixable = []

builtins = ["const", "ptr8"]

# Exclude a variety of commonly ignored directories.
exclude = [
    ".bzr",
    ".direnv",
    ".eggs",
    ".git",
    ".hg",
    ".mypy_cache",
    ".nox",
    ".pants.d",
    ".pytype",
    ".ruff_cache",
    ".svn",
    ".tox",
    ".venv",
    "__pypackages__",
    "_build",
    "buck-out",
    "build",
    "dist",
    "node_modules",
    "venv",
    "tools/typings",
]

# Same as our configuration of Black.
line-length = 99

# Allow unused variables when underscore-prefixed.
dummy-variable-rgx = "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$"

# Assume Python 3.10 for typing syntax compatibility.
target-version = "py310"

# Avoid automatically removing unused imports in __init__.py files.
ignore-init-module-imports = true

typing-modules = ["micropython-[[target_port]]-stubs"]

[tool.ruff.mccabe]
max-complexity = 10

[tool.ruff.per-file-ignores]
"manifest.py" = ["F821"]  # "Undefined name" for eg. freeze, include, etc.

[tool.ruff.format]
exclude = [
    "src/lib",
    "src/micropython",
]

[tool.pyright]
include = ["src"]
ignore = ["**/typings"]
exclude = [".*", "__*", "**/typings"]

typeCheckingMode = "basic"
stubPath = "tools/typings"
typeshedPath = "tools/typings"
pythonPlatform = "Linux"
pythonVersion = "3.10"

reportMissingModuleSource = "none"
reportUnnecessaryTypeIgnoreComment = "information"

executionEnvironments = [
  { root = "src", pythonVersion = "3.10", pythonPlatform = "Linux"},
]

# Should be kept in sync with mypy_path below
extraPaths = [
    "tools/typings",
    "src/firmware/application",
    "src/firmware/test",
    "src/micropython/extmod",
    "src/libs/micropython-lib/micropython/aiorepl",
    "src/libs/micropython-lib/python-stdlib/logging",
    "src/libs/micropython-lib/python-stdlib/unittest",
[% if target_port == "unix" %]
    # On the unix port the simulation modules are the implementation, so they
    # are the right thing for `machine` to resolve to. On a real port they
    # would shadow the port stubs.
    "src/unix/simulation",
[% endif %]
]

[tool.mypy]
platform = "linux"
python_version = "3.10"

# Should be kept in sync with pyright extraPaths above
# When new library / submodules are added to the project, add them here
mypy_path = [
    "tools/typings",
    "src/firmware/application",
    "src/firmware/test",
    "src/micropython/extmod",
    "src/libs/micropython-lib/micropython/aiorepl",
    "src/libs/micropython-lib/python-stdlib/logging",
    "src/libs/micropython-lib/python-stdlib/unittest",
[% if target_port == "unix" %]
    # On the unix port the simulation modules are the implementation, so they
    # are the right thing for `machine` to resolve to. On a real port they
    # would shadow the port stubs.
    "src/unix/simulation",
[% endif %]
]

custom_typeshed_dir = "tools/typings"
files = "*.py"

# Note: pre-commit sends all changed files explicitly to mypy,
# bypassing this exclude setting. Ensure pre-commit settings
# limit checked files appropriately.
exclude = ['src/micropython/', 'src/libs/', 'tools/typings[\\/].*']

# Allow use of own stubs library in tools/typings
# https://micropython-stubs.readthedocs.io/en/main/pyproject.html
follow_imports = "silent"
follow_imports_for_stubs = true
no_site_packages = true
check_untyped_defs = true

[[ "[[" ]]tool.mypy.overrides]]
# Ignore mypy errors in libraries (should be checked & fixed in library itself)
module = [
    'manifest',
]
ignore_errors = true
