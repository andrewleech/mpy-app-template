---
stages:
  - quality
  - test
  - build
  - release

variables:
  GIT_SUBMODULE_STRATEGY: none  # Submodules are fetched by `make submodules`.
  GIT_DEPTH: 0                  # git-versioner needs the tag history.
  RUN_IN_DOCKER: 0              # Jobs already run inside the toolchain image.

checks:
  stage: quality
  image: python:3.12-slim
  before_script:
    - pip install --quiet uv
  script:
    - uvx pre-commit run --all-files

unit-tests:
  stage: test
  # Resolved from mpbuild by tools/initial_setup.py; `make setup` refreshes it.
  image: "@UNIX_BUILD_CONTAINER@"
  before_script:
    - git config --global --add safe.directory '*'
  script:
    - make submodules
    - make tests
  artifacts:
    when: always
    paths:
      - results/
    reports:
      junit: results/*.xml

firmware:
  stage: build
  # Resolved from mpbuild by tools/initial_setup.py; `make setup` refreshes it.
  image: "@BUILD_CONTAINER@"
  before_script:
    - git config --global --add safe.directory '*'
  script:
    - make submodules
    - make system
[% if use_mboot %]
    - make mboot
[% endif %]
  artifacts:
    paths:
      - src/system/build-[[ project_board_name ]]/firmware.*
[% if use_mboot %]
      - src/system/build-[[ project_board_name ]]/bootloader.*
[% endif %]
      - src/system/build-[[ project_board_name ]]/version.txt

release:
  stage: release
  image: registry.gitlab.com/gitlab-org/release-cli:latest
  rules:
    - if: $CI_COMMIT_TAG =~ /^v/
  needs:
    - job: firmware
      artifacts: true
  script:
    - echo "Publishing $CI_COMMIT_TAG"
  release:
    tag_name: $CI_COMMIT_TAG
    description: "[[ project_name ]] $CI_COMMIT_TAG"
