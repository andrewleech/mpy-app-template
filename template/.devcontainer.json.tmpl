{
  "name": "[[project_name]]",
  // Resolved from mpbuild by tools/initial_setup.py; `make setup` refreshes it.
  "image": "@BUILD_CONTAINER@",
  "postCreateCommand": "make submodules && uvx pre-commit install",
  "containerEnv": {
    "DEVCONTAINER": "1"
  },
  "runArgs": [
    "-e", "GIT_EDITOR=code --wait",
    // Match the host user so files created in the container are not root owned.
    "--user=1000:1000",
    "-eHOME=/home",
    "--hostname=[[project_name]]",
    "--add-host=[[project_name]]:127.0.0.1",
    // Share the host display and network so flashing and debug tools can run
    // inside the container.
    "--env=\"DISPLAY\"",
    "--net=host",
    // Docker blocks device access by default, which stops debug probes and
    // serial adapters from being visible.
    "--privileged"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.makefile-tools",
        "marus25.cortex-debug",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.pythonPath": "/usr/bin/python3"
      }
    }
  },
  "updateRemoteUserUID": true,
  "mounts": [
    // Map user ssh settings and auth into the container for git use.
    "source=${localEnv:HOME}/.ssh,target=/home/.ssh,type=bind,consistency=cached",
    // USB access, for flashing and serial.
    "type=bind,source=/dev,target=/dev",
    "type=bind,source=/dev/bus/usb,target=/dev/bus/usb",
    // Bring the local timezone into the container.
    "type=bind,readonly,source=/etc/localtime,target=/etc/localtime"
  ]
}
